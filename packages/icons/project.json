{
  "name": "@alma-oss/spirit-icons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/icons/src",
  "projectType": "library",
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "generate": {
      "outputs": ["{projectRoot}/.icons-tmp"],
      "inputs": ["{projectRoot}/src/svg/**/*", "{projectRoot}/scripts/**/*", "^production"],
      "cache": true,
      "dependsOn": ["@alma-oss/spirit-design-tokens:build"]
    }
  }
}
