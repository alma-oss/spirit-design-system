{
  "name": "@alma-oss/spirit-web-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/web-react/src",
  "projectType": "library",
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "types": {
      "cache": true,
      "dependsOn": ["@alma-oss/spirit-icons:build", "@alma-oss/spirit-design-tokens:build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint ./",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      // `import/resolver` (see `configs/eslint-config-spirit`) prefers each workspace package's
      // `development` export condition over `dist`, so linting only needs the cheap
      // `@alma-oss/spirit-icons:generate` codegen step, not a full icons build.
      "dependsOn": ["@alma-oss/spirit-icons:generate", "@alma-oss/spirit-design-tokens:build"]
    },
    "lint-fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint ./ --fix",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["@alma-oss/spirit-icons:generate", "@alma-oss/spirit-design-tokens:build"]
    }
  }
}
