{
  "defaultBase": "origin/main",
  "pluginsConfig": {
    "@nrwl/js": {
      "analyzeSourceFiles": false
    }
  },
  "targets": {
    "build": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "!{projectRoot}/CHANGELOG.md", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/.yarnrc.yml",
      "{workspaceRoot}/lerna.json",
      "{workspaceRoot}/jest.config.*",
      "{workspaceRoot}/eslint.config.*",
      "{workspaceRoot}/.prettierrc*",
      "{workspaceRoot}/.prettierignore",
      "{workspaceRoot}/.remarkrc*",
      "{workspaceRoot}/.remarkignore",
      "{workspaceRoot}/.editorconfig"
    ],
    "production": ["default"]
  },
  "targetDefaults": {
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "types": {
      "cache": true
    },
    "build": {
      "cache": true
    },
    "test:unit": {
      "inputs": ["default", "^default"]
    },
    "test:unit:coverage": {
      "inputs": ["default", "^default"]
    }
  },
  "neverConnectToCloud": true,
  "tui": {
    "enabled": false
  },
  "analytics": false
}
