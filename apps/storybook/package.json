{
  "name": "@alma-oss/spirit-storybook",
  "version": "0.6.2",
  "description": "Storybook of the Spirit Design System",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/alma-oss/spirit-design-system.git",
    "directory": "apps/storybook"
  },
  "scripts": {
    "start": "storybook dev --config-dir ./ --port 6006 --no-open",
    "build": "storybook build --config-dir ./ --output-dir ./build --stats-json",
    "start:story-ui": "story-ui start",
    "start:story-ui-mcp": "story-ui mcp",
    "start:ui": "cross-env STORY_UI=true npm-run-all --parallel start start:story-ui"
  },
  "devDependencies": {
    "@alma-oss/spirit-common": "workspace:^",
    "@alma-oss/spirit-design-tokens": "workspace:^",
    "@alma-oss/spirit-icons": "workspace:^",
    "@alma-oss/spirit-web-react": "workspace:^",
    "@babel/core": "catalog:build",
    "@storybook/addon-a11y": "catalog:storybook",
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/addon-mcp": "catalog:storybook",
    "@storybook/html": "catalog:storybook",
    "@storybook/mcp": "catalog:storybook",
    "@storybook/react": "catalog:storybook",
    "@storybook/react-vite": "catalog:storybook",
    "@tpitre/story-ui": "catalog:storybook",
    "@vitejs/plugin-react": "catalog:build",
    "cross-env": "catalog:script",
    "npm-run-all2": "catalog:script",
    "postcss": "catalog:build",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-image-crop": "catalog:frontend",
    "storybook": "catalog:storybook",
    "typescript": "catalog:types",
    "vite": "catalog:build"
  }
}
