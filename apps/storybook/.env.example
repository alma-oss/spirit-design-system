# Story UI configuration
# Copy this file to .env and put your own API key in it. Never commit .env.

# LLM providers. Set one key or both; leave unused keys empty (any non-empty value counts as configured).
# DEFAULT_PROVIDER is used when its key is set, otherwise Story UI falls back to the provider that has a key.
# The provider can also be switched per session in the workspace settings menu.
DEFAULT_PROVIDER=claude

# API key for Anthropic Claude
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# API key for Google Gemini
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Storybook the server verifies generated stories against
STORYBOOK_URL=http://localhost:6006
