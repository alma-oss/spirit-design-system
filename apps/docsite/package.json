{
  "name": "@alma-oss/spirit-docsite",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 4321",
    "build": "next build",
    "start": "next dev --turbopack --port 4321",
    "start:prod": "next start --port 4321",
    "css:lint": "stylelint \"src/domains/homepage/**/*.scss\" --cache --cache-location .cache/.stylelintcache",
    "css:lint:fix": "stylelint \"src/domains/homepage/**/*.scss\" --fix",
    "lint": "npm-run-all --serial lint:scripts css:lint",
    "lint:fix": "npm-run-all --serial lint:scripts:fix css:lint:fix",
    "lint:scripts": "eslint",
    "lint:scripts:fix": "eslint --fix",
    "test": "npm-run-all --serial lint test:unit:coverage types",
    "test:unit": "TS_NODE_PROJECT=./tsconfig.test.json jest",
    "test:unit:watch": "yarn test:unit --watchAll",
    "test:unit:coverage": "yarn test:unit --coverage",
    "types": "tsc"
  },
  "dependencies": {
    "@alma-oss/spirit-common": "workspace:^",
    "@alma-oss/spirit-design-tokens": "workspace:^",
    "@alma-oss/spirit-icons": "workspace:^",
    "@alma-oss/spirit-web": "workspace:^",
    "@alma-oss/spirit-web-react": "workspace:^",
    "@almacareer/cookie-consent-manager": "catalog:docsite",
    "@next/mdx": "catalog:content",
    "@next/third-parties": "catalog:docsite",
    "classnames": "catalog:frontend",
    "handlebars": "catalog:build",
    "lottie-react": "catalog:frontend",
    "next": "catalog:frontend",
    "next-mdx-remote": "catalog:content",
    "nuqs": "catalog:docsite",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "rehype-pretty-code": "catalog:content",
    "rehype-raw": "catalog:content",
    "remark-gfm": "catalog:content",
    "sass-embedded": "catalog:build",
    "shiki": "catalog:content",
    "yaml": "catalog:script"
  },
  "devDependencies": {
    "@eslint/compat": "catalog:lint",
    "@eslint/eslintrc": "catalog:lint",
    "@mdx-js/loader": "catalog:content",
    "@mdx-js/react": "catalog:content",
    "@next/eslint-plugin-next": "catalog:lint",
    "@testing-library/dom": "catalog:test",
    "@testing-library/react": "catalog:test",
    "@types/mdx": "catalog:types",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "autoprefixer": "catalog:build",
    "eslint": "catalog:lint",
    "eslint-config-next": "catalog:lint",
    "eslint-config-spirit": "workspace:^",
    "globals": "catalog:lint",
    "jest": "catalog:test",
    "jest-config-spirit": "workspace:^",
    "npm-run-all2": "catalog:script",
    "postcss": "catalog:build",
    "postcss-preset-env": "catalog:build",
    "stylelint": "catalog:lint",
    "stylelint-config-spirit": "workspace:^",
    "ts-node": "catalog:script",
    "typescript": "catalog:types"
  }
}
