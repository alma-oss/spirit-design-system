{
  "name": "@alma-oss/spirit-docsite",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docsite/src",
  "projectType": "application",
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/.next"],
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "{workspaceRoot}/docs/introduction/**/*.md",
        "{workspaceRoot}/docs/design/**/*.md",
        "{workspaceRoot}/docs/development/**/*.md",
        "{workspaceRoot}/docs/migrations/index.md",
        "{workspaceRoot}/packages/web-react/src/components/**/docs/*.md"
      ],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"]
    },
    "start": {
      "dependsOn": ["^build", "@alma-oss/spirit-icons:build"]
    },
    "lint": {
      "dependsOn": ["@alma-oss/spirit-icons:build"]
    },
    "types": {
      "dependsOn": ["^build"]
    }
  },
  "implicitDependencies": [
    "@alma-oss/spirit-design-tokens",
    "@alma-oss/spirit-icons",
    "@alma-oss/spirit-web",
    "@alma-oss/spirit-web-react"
  ]
}
