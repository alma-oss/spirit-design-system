{
  "extends": "../../configs/typescript-config-spirit/dom",
  "compilerOptions": {
    "baseUrl": ".",
    "useUnknownInCatchVariables": false,
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@local/*": ["./src/*"],
      "@alma-oss/spirit-web-react/*": ["../../packages/web-react/src/*"],
      "@alma-oss/spirit-web/*": ["../../packages/web/src/*"]
    },
    "forceConsistentCasingInFileNames": true,
    "target": "esnext",
    "module": "esnext",
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/web-react/src/global.d.ts",
    "../../packages/web/src/js/global.d.ts"
  ],
  "exclude": ["node_modules"]
}
