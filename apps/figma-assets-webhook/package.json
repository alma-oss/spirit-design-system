{
  "name": "@alma-oss/spirit-figma-assets-webhook",
  "version": "0.0.0",
  "description": "Securely dispatch Figma asset library publishes to GitHub Actions",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "yarn types",
    "lint": "eslint ./",
    "lint:fix": "yarn lint --fix",
    "test": "npm-run-all --serial lint types test:unit",
    "test:unit": "node --import tsx --test --experimental-test-coverage --test-coverage-include='netlify/functions/**/*.mts' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 ./tests/*.test.mjs",
    "types": "tsc --noEmit"
  },
  "devDependencies": {
    "@netlify/blobs": "catalog:build",
    "@netlify/functions": "catalog:build",
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "eslint-config-spirit": "workspace:^",
    "npm-run-all2": "catalog:script",
    "tsx": "catalog:script",
    "typescript": "catalog:types"
  }
}
