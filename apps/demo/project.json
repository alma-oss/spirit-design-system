{
  "name": "@lmc-eu/spirit-demo-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/demo",
  "projectType": "application",
  "implicitDependencies": ["@alma-oss/spirit-web", "@alma-oss/spirit-web-react"],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/build"],
      "cache": true,
      "dependsOn": ["^build", "copy-icons"],
      "inputs": ["default", "^default", "{workspaceRoot}/index.html", "{workspaceRoot}/static/**/*"]
    },
    "copy-icons": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cp -r packages/icons/dist/. static/assets/icons",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["@alma-oss/spirit-icons:build"]
    },
    "start": {
      "dependsOn": ["copy-icons"]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn playwright test",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tests/**/*",
        "{workspaceRoot}/playwright.config.ts",
        "{workspaceRoot}/playwright.d.ts",
        "{workspaceRoot}/.github/actions/**/*",
        "{workspaceRoot}/.github/workflows/{build,continuous-integration,e2e,deploy}.y*ml"
      ],
      "cache": false
    }
  }
}
