{
  "name": "@alma-oss/spirit-figma-assets-exporter",
  "version": "0.0.0",
  "description": "Synchronize design assets from Figma into source repositories",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": "./dist/bin/figma-assets.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "lint": "eslint ./",
    "lint:fix": "yarn lint --fix",
    "sync": "tsx ./src/bin/figma-assets.js sync",
    "test": "npm-run-all --serial lint types build test:unit",
    "test:unit": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 ./tests/*.test.mjs",
    "types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "eslint-config-spirit": "workspace:^",
    "npm-run-all2": "catalog:script",
    "tsup": "catalog:build",
    "tsx": "catalog:script",
    "typescript": "catalog:types"
  }
}
