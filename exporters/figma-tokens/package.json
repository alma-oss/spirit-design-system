{
  "name": "@alma-oss/spirit-figma-tokens-exporter",
  "version": "0.0.0",
  "description": "Synchronize design tokens from Figma into source directories",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": "./dist/bin/figma-tokens.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm-run-all --serial build:compile build:bin",
    "build:bin": "shx mkdir -p dist/bin && shx cp src/bin/figma-tokens.js dist/bin/figma-tokens.js",
    "build:compile": "vite build",
    "lint": "eslint ./",
    "lint:fix": "yarn lint --fix",
    "sync": "tsx ./src/bin/figma-tokens.js sync",
    "test": "npm-run-all --serial lint types build test:unit",
    "test:unit": "jest",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "cosmiconfig": "catalog:script",
    "sade": "catalog:script",
    "zod": "catalog:script"
  },
  "devDependencies": {
    "@eslint/compat": "catalog:lint",
    "@eslint/eslintrc": "catalog:lint",
    "@lmc-eu/eslint-config-jest": "catalog:lint",
    "@lmc-eu/eslint-config-typescript": "catalog:lint",
    "@swc/core": "catalog:build",
    "@swc/jest": "catalog:test",
    "@types/jest": "catalog:types",
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "eslint-config-spirit": "workspace:^",
    "jest": "catalog:test",
    "jest-config-spirit": "workspace:^",
    "npm-run-all2": "catalog:script",
    "prettier-config-spirit": "workspace:^",
    "shx": "catalog:script",
    "tsx": "catalog:script",
    "typescript": "catalog:types",
    "vite": "catalog:build",
    "vite-plugin-dts": "catalog:build",
    "vite-plugin-externalize-deps": "catalog:build"
  }
}
